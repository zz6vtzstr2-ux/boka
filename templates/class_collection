<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>班级收藏册 · 搏卡游戏</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #1a1a2e; color: #eee;
           max-width: 900px; margin: 0 auto; padding: 16px; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .back { color: #888; text-decoration: none; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
    .card { background: #16213e; border-radius: 10px; padding: 10px; text-align: center;
            position: relative; }
    .card img { width: 100%; border-radius: 6px; }
    .card .atk { position: absolute; left: 4px; bottom: 4px; font-size: 13px; color: #e94560; }
    .card .def { position: absolute; right: 4px; bottom: 4px; font-size: 13px; color: #4ecca3; }
    .card .name { font-size: 13px; margin-top: 4px; }
    .card .donor { font-size: 11px; color: #888; }
    .card.empty { background: #0f3460; display: flex; align-items: center;
                  justify-content: center; height: 180px; color: #666; font-size: 14px; }
  </style>
</head>
<body>
  <header>
    <h2>班级收藏册</h2>
    <a href="/" class="back">返回主页</a>
  </header>

  <div class="card-grid">
    {% for c in cards %}
      {% if c.owned %}
      <div class="card">
        <img src="/static/cards/{{ c.name }}.jpg" alt="{{ c.name }}">
        <div class="atk">🗡️{{ c.atk }}</div>
        <div class="def">🛡️{{ c.def }}</div>
        <div class="name">{{ c.nick }}·{{ c.name }}</div>
        <div class="donor">{{ c.donated_at }} 由 {{ c.donor }} 捐献</div>
      </div>
      {% else %}
      <div class="card empty">待收集</div>
      {% endif %}
    {% endfor %}
  </div>
</body>
</html>
